# LEMP Stack + Zabbix - Configuración de Variables de Entorno
# Copia este archivo a .env y modifica los valores según tus necesidades

# =============================================================================
# CONFIGURACIÓN DE PUERTOS
# =============================================================================
# IMPORTANTE: Cambia estos puertos si tienes conflictos con otros servicios

# Nginx HTTP (por defecto: 8081)
NGINX_HTTP_PORT=8081

# Nginx HTTPS (por defecto: 8444)
NGINX_HTTPS_PORT=8444

# MySQL (por defecto: 3307)
MYSQL_PORT=3307

# Zabbix Agent (por defecto: 10050)
# ¡IMPORTANTE! Cambia este puerto si ya tienes un servidor Zabbix corriendo
ZABBIX_AGENT_PORT=10050

# =============================================================================
# CONFIGURACIÓN DE CONTENEDOR
# =============================================================================

# Nombre del contenedor (por defecto: lemp-zabbix-test)
CONTAINER_NAME=lemp-zabbix-test

# =============================================================================
# CONFIGURACIÓN DE MYSQL
# =============================================================================

# Contraseña del usuario root de MySQL
MYSQL_ROOT_PASSWORD=root123

# Nombre de la base de datos
MYSQL_DATABASE=testdb

# Usuario de MySQL
MYSQL_USER=testuser

# Contraseña del usuario de MySQL
MYSQL_PASSWORD=testpass

# =============================================================================
# CONFIGURACIÓN DE ZABBIX
# =============================================================================

# Dirección del servidor Zabbix (por defecto: host.docker.internal)
ZABBIX_SERVER=host.docker.internal

# Puerto del servidor Zabbix (por defecto: 10051)
ZABBIX_SERVER_PORT=10051

# =============================================================================
# CONFIGURACIONES ADICIONALES
# =============================================================================

# Timezone (por defecto: UTC)
TZ=UTC

# Entorno (development, testing, production)
ENVIRONMENT=development

# =============================================================================
# EJEMPLOS DE CONFIGURACIÓN PARA DIFERENTES ESCENARIOS
# =============================================================================

# ESCENARIO 1: Múltiples instancias del proyecto
# NGINX_HTTP_PORT=8082
# NGINX_HTTPS_PORT=8445
# MYSQL_PORT=3308
# ZABBIX_AGENT_PORT=10051
# CONTAINER_NAME=lemp-zabbix-test-2

# ESCENARIO 2: Conflicto con servidor Zabbix existente
# ZABBIX_AGENT_PORT=10052
# ZABBIX_SERVER=192.168.1.100
# ZABBIX_SERVER_PORT=10051

# ESCENARIO 3: Desarrollo con Laravel Herd
# NGINX_HTTP_PORT=8081
# NGINX_HTTPS_PORT=8444
# MYSQL_PORT=3307
# ZABBIX_AGENT_PORT=10050

# ESCENARIO 4: Producción local
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# MYSQL_PORT=3306
# ZABBIX_AGENT_PORT=10050
# MYSQL_ROOT_PASSWORD=tu_password_seguro
# MYSQL_PASSWORD=tu_password_seguro
